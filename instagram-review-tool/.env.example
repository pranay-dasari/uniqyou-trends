# Copy to .env and fill in. Never commit .env.

# OPTIONAL. Meta's Instagram oEmbed endpoint works without a token (lower rate
# limits). For higher limits, set a Meta *Facebook* app token:
#   "<META_APP_ID>|<CLIENT_TOKEN>"   (App settings -> Advanced -> Client token)
# This is NOT the "Instagram app ID/secret" from "API setup with Instagram login".
# If Meta rejects the token (e.g. oEmbed Read not yet approved), the app
# automatically falls back to tokenless requests.
# See README "Instagram/Meta API configuration".
# INSTAGRAM_ACCESS_TOKEN=

# Graph API version. Keep this on a version Meta currently supports.
META_GRAPH_API_VERSION=v25.0

# Seconds before an Instagram API request is abandoned.
INSTAGRAM_TIMEOUT_SECONDS=10

# SQLite database location (created automatically on first start).
# Defaults to <project>/data/instagram_review.db. Relative sqlite paths resolve
# against the directory you run streamlit from, so prefer an absolute path.
# DATABASE_URL=sqlite:////absolute/path/instagram_review.db
# Supabase / Postgres (use the Session pooler string, needed for Streamlit Cloud):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
